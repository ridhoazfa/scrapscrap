# ============================================================
# ScrapScrap Configuration Template
# Copy this file to .env and adjust your parameters.
# ============================================================

# Target Market Settings
SCRAPER_CITIES=Jakarta,Surabaya,Bandung,Medan
SCRAPER_NICHES=Gym,Restaurant,Dental Clinic,Lawyer,Cleaning Service,Salon
SCRAPER_LOCALE=id

# Lead Quality Thresholds
SCRAPER_MIN_REVIEWS=100
SCRAPER_MIN_RATING=4.0
SCRAPER_MAX_PER_SEARCH=500
SCRAPER_NICHE_EMAIL_QUOTA=10

# Crawler Performance & Concurrency
SCRAPER_HEADLESS=true
EMAIL_CRAWLER_CONCURRENCY=20
SCRAPER_SCROLL_DELAY_MS=50
SCRAPER_FIND_PAUSE_MS=10
SCRAPER_SKIP_PAUSE_MS=1

# Web Studio Port
PORT=3800

# Optional: Webhook Dispatcher (Zapier, Make, n8n, Custom CRM)
# WEBHOOK_URL=https://your-crm.com/api/leads
